{
  "id": "deckrender-sdk",
  "displayName": "Frozen DeckRender sdk",
  "profile": "render",
  "adapter": {
    "type": "command",
    "command": [
      "python3",
      "{repo}/benchmark/adapters/target.py",
      "--input",
      "{input}",
      "--output",
      "{output_dir}",
      "--case",
